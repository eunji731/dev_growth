views:
  - type: table
    name: 표
    filters:
      and:
        - file.inFolder("02 Study")
    sort:
      - property: file.mtime
        direction: DESC
    limit: 10
  - type: list
    name: 리스트
    filters:
      and:
        - file.inFolder("02 Study")
    markers: none
    indentProperties: false
  - type: cards
    name: 카드
    filters:
      and:
        - file.inFolder("02 Study")
    cardSize: 140
